      <div className="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
        
        {/* Cabecera de Sección */}
        <div className="text-center max-w-3xl mx-auto space-y-3">
          <div className="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-linen border border-linen-dark text-teal text-xs font-semibold uppercase tracking-wider">
            <Sparkles className="w-3.5 h-3.5 text-bronze" />
            <span>{lang === 'es' ? 'Presentación Audiovisual' : 'Institutional Video'}</span>
          </div>

          <h2 className="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-charcoal tracking-tight">
            {lang === 'es' ? (
              <>
                Instalaciones Corporativas de <span className="text-teal italic">Primer Nivel</span>
              </>
            ) : (
              <>
                Premier Corporate <span className="text-teal italic">Facilities & Practice</span>
              </>
            )}
          </h2>

          <p className="text-charcoal-soft text-sm sm:text-base leading-relaxed font-light">
            {lang === 'es' 
              ? 'Conozca nuestras oficinas en los distritos financieros de Miami, Houston y Nueva York. Salas de juntas equipadas para litigio federal y un equipo volcado en la victoria de su caso.'
              : 'Tour our corporate suites in Miami, Houston, and New York. Purpose-built facilities for federal hearings and a dedicated legal staff committed to your case.'
            }
          </p>

          {/* Navegación por Pestañas de Escenas */}
          <div className="flex flex-wrap justify-center gap-2 pt-2">
            {tabs.map((t) => {
              const Icon = t.icon;
              const isActive = activeTab === t.id;
              return (
                <button
