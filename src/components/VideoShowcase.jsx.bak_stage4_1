                  onClick={() => setActiveTab(t.id)}
                  className={`flex items-center space-x-2 px-4 py-2 rounded-lg text-xs font-semibold transition-all duration-200 cursor-pointer ${
                    isActive
                      ? 'bg-teal text-white shadow-sm font-semibold'
                      : 'bg-white text-charcoal-soft hover:text-charcoal border border-linen-dark hover:bg-ivory'
                  }`}
                >
                  <Icon className={`w-3.5 h-3.5 ${isActive ? 'text-bronze-light' : 'text-bronze'}`} />
                  <span>{lang === 'es' ? t.labelEs : t.labelEn}</span>
                </button>
              );
            })}
          </div>
        </div>

        {/* REPRODUCTOR VISUAL PRINCIPAL */}
        <div className="relative rounded-2xl overflow-hidden border border-linen-dark shadow-elevated group bg-charcoal">
          <div className="relative h-[380px] sm:h-[480px] lg:h-[520px] w-full overflow-hidden">
            <img
              src={currentScene.image}
              alt={currentScene.titleEs}
              className="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-1000"
            />
            {/* Gradientes cinematográficos suaves */}
            <div className="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-charcoal/20 to-transparent pointer-events-none" />

            {/* Botón Central de Play con Estilo Bronce y Teal */}
            <div className="absolute inset-0 flex items-center justify-center">
              <button
                onClick={onOpenVideoModal}
                className="relative flex items-center justify-center w-20 h-20 sm:w-22 sm:h-22 rounded-full bg-teal/95 hover:bg-teal text-white shadow-premium group cursor-pointer transition-all duration-300 hover:scale-105 border border-bronze/40"
                aria-label="Reproducir video institucional"
              >
                <div className="absolute inset-0 rounded-full bg-bronze animate-ping opacity-20" />
                <Play className="w-8 h-8 fill-bronze-light ml-1 text-bronze-light" />
              </button>
            </div>

            {/* Badge de Escena */}
            <div className="absolute top-5 left-5">
              <span className="px-3.5 py-1.5 rounded-md bg-white/90 backdrop-blur-md text-charcoal text-xs font-semibold tracking-wider uppercase border border-linen-dark shadow-sm">
                {lang === 'es' ? currentScene.tagEs : currentScene.tagEn}
              </span>
            </div>

            {/* Badge de Calidad */}
            <div className="absolute top-5 right-5 flex items-center space-x-2">
              <span className="px-2.5 py-1 rounded bg-black/60 backdrop-blur-md text-white font-mono text-[10px] font-bold">
                4K UHD
              </span>
            </div>

            {/* Barra Inferior con Título */}
            <div className="absolute bottom-0 inset-x-0 p-6 sm:p-8 bg-gradient-to-t from-charcoal via-charcoal/80 to-transparent">
              <div className="max-w-3xl space-y-1.5">
                <h3 className="font-serif text-xl sm:text-2xl font-bold text-white">
                  {lang === 'es' ? currentScene.titleEs : currentScene.titleEn}
                </h3>
                <p className="text-xs sm:text-sm text-slate-200 leading-relaxed font-light">
                  {lang === 'es' ? currentScene.descEs : currentScene.descEn}
                </p>
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>
