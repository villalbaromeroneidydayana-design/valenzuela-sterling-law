          <div className="xl:hidden bg-[#0D3B36] border-b border-white/10 px-6 py-6 space-y-5 shadow-2xl animate-in slide-in-from-top-3 duration-200">
            <div className="flex flex-col space-y-3 text-sm font-medium text-slate-200">
              <a href="#hero" onClick={() => setMobileMenuOpen(false)} className="py-1 border-b border-white/10 hover:text-white">
                {lang === 'es' ? 'Inicio' : 'Home'}
              </a>
              <a href="#la-firma" onClick={() => setMobileMenuOpen(false)} className="py-1 border-b border-white/10 hover:text-white">
