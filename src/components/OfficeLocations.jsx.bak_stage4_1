import React from 'react';
import { OFFICES } from '../data/demoData';
import { MapPin, Phone, Clock, ArrowUpRight, Building2 } from 'lucide-react';

export default function OfficeLocations({ lang, onOpenEvaluator }) {
  return (
    <section id="sedes" className="py-20 bg-ivory-warm text-charcoal relative scroll-mt-28 border-b border-linen-dark/60">
      <div className="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
        
        {/* Cabecera */}
        <div className="text-center max-w-3xl mx-auto space-y-3">
          <div className="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-linen border border-linen-dark text-teal text-xs font-semibold uppercase tracking-wider">
            <Building2 className="w-3.5 h-3.5 text-bronze" />
            <span>{lang === 'es' ? 'Infraestructura Corporativa' : 'Corporate Footprint'}</span>
          </div>

          <h2 className="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-charcoal tracking-tight">
            {lang === 'es' ? (
              <>
                Nuestras Sedes en los <span className="text-teal italic">Distritos Financieros de EE. UU.</span>
              </>
            ) : (
              <>
                Our Offices in Leading <span className="text-teal italic">U.S. Business Districts</span>
              </>
            )}
          </h2>

          <p className="text-charcoal-soft text-sm sm:text-base leading-relaxed font-light">
            {lang === 'es' 
              ? 'Oficinas físicas equipadas en Florida, Texas y Nueva York. Atendemos consultas presenciales y remotas con validez en los 50 estados de la Unión Americana.'
              : 'Established corporate suites in Florida, Texas, and New York. Offering in-person consultations and secure virtual representation across all 50 states.'
            }
          </p>
        </div>

        {/* Grid de 4 Sedes en Blanco / Lino */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {OFFICES.map((office, idx) => (
            <div
              key={idx}
              className="bg-white border border-linen-dark hover:border-bronze/50 rounded-2xl overflow-hidden shadow-subtle hover:shadow-premium transition-all duration-300 flex flex-col justify-between group"
            >
              {/* Foto de la sede / distrito */}
              <div className="relative h-44 overflow-hidden bg-linen">
                <img
                  src={office.image}
                  alt={office.city}
                  className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />
                <div className="absolute inset-0 bg-gradient-to-t from-charcoal/40 via-transparent to-transparent" />
                
                {office.isHQ && (
                  <div className="absolute top-3 left-3 bg-teal text-white text-[10px] font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded shadow-sm">
                    {lang === 'es' ? 'Sede Principal' : 'Headquarters'}
                  </div>
                )}
              </div>

              {/* Contenido de la sede */}
              <div className="p-5 space-y-3 flex-1 flex flex-col justify-between">
                <div className="space-y-2">
                  <div className="flex items-center space-x-2">
                    <MapPin className="w-4 h-4 text-bronze flex-shrink-0" />
                    <h3 className="font-serif text-lg font-bold text-charcoal">
                      {lang === 'es' ? office.city : office.cityEn}
                    </h3>
                  </div>

                  <p className="text-xs text-charcoal-soft leading-relaxed font-light">
                    {office.address}
                  </p>

                  <div className="pt-2 space-y-1.5 text-[11px] text-charcoal-soft">
                    <div className="flex items-center space-x-2">
                      <Phone className="w-3.5 h-3.5 text-bronze" />
                      <a href={`tel:${office.phone.replace(/[^0-9+]/g, '')}`} className="hover:text-teal font-semibold text-charcoal">
                        {office.phone}
                      </a>
                    </div>
                    <div className="flex items-center space-x-2">
                      <Clock className="w-3.5 h-3.5 text-bronze" />
                      <span>{lang === 'es' ? office.hours : office.hoursEn}</span>
                    </div>
                  </div>
                </div>

                <div className="pt-4 border-t border-linen mt-3">
                  <button
                    onClick={onOpenEvaluator}
                    className="w-full py-2 bg-ivory-warm hover:bg-teal hover:text-white text-xs font-semibold text-charcoal rounded-lg border border-linen-dark transition-colors cursor-pointer flex items-center justify-center space-x-1.5"
                  >
                    <span>{lang === 'es' ? 'Agendar en esta Sede' : 'Book at This Office'}</span>
                    <ArrowUpRight className="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>

            </div>
          ))}
        </div>

      </div>
    </section>
  );
}
