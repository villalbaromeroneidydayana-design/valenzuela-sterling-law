import React, { useState } from 'react';
import { BLOG_POSTS } from '../data/demoData';
import { BookOpen, Calendar, Clock, ArrowRight, X } from 'lucide-react';

export default function BlogPreview({ lang, onOpenEvaluator }) {
  const [selectedPost, setSelectedPost] = useState(null);

  return (
    <section id="blog" className="py-20 bg-ivory text-charcoal relative scroll-mt-28 border-b border-linen-dark/60">
      <div className="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
        
        {/* Cabecera */}
        <div className="text-center max-w-3xl mx-auto space-y-3">
          <div className="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-linen border border-linen-dark text-teal text-xs font-semibold uppercase tracking-wider">
            <BookOpen className="w-3.5 h-3.5 text-bronze" />
            <span>{lang === 'es' ? 'Actualidad Jurídica Migratoria' : 'Immigration Legal Insights'}</span>
          </div>

          <h2 className="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-charcoal tracking-tight">
            {lang === 'es' ? (
              <>
                Análisis y Novedades sobre <span className="text-teal italic">Leyes de Inmigración</span>
              </>
            ) : (
              <>
                Recent Articles & <span className="text-teal italic">USCIS Regulatory Updates</span>
              </>
            )}
          </h2>

          <p className="text-charcoal-soft text-sm sm:text-base leading-relaxed font-light">
            {lang === 'es' 
              ? 'Artículos elaborados por nuestros abogados para mantener a la comunidad informada sobre cambios en el Boletín de Visas, políticas del DHS y precedentes judiciales.'
              : 'Legal commentary crafted by our attorneys tracking Visa Bulletin updates, Department of Homeland Security directives, and precedent rulings.'
            }
          </p>
        </div>

        {/* Grid de 3 Artículos en Blanco / Lino */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
          {BLOG_POSTS.map((post) => (
            <div
              key={post.id}
              className="bg-white border border-linen-dark hover:border-bronze/50 rounded-2xl overflow-hidden shadow-subtle hover:shadow-premium transition-all duration-300 flex flex-col justify-between group"
            >
              {/* Imagen del artículo */}
              <div className="relative h-48 overflow-hidden bg-linen">
                <img
                  src={post.image}
                  alt={post.titleEs}
                  className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />
                <span className="absolute top-3 left-3 bg-white/95 backdrop-blur-md border border-linen-dark text-teal text-[10px] font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded-md shadow-sm">
                  {post.category}
                </span>
              </div>

              {/* Contenido */}
              <div className="p-6 space-y-3 flex-1 flex flex-col justify-between">
                <div className="space-y-2">
                  <div className="flex items-center space-x-3 text-[11px] text-charcoal-light">
                    <span className="flex items-center space-x-1">
                      <Calendar className="w-3.5 h-3.5 text-bronze" />
                      <span>{post.date}</span>
                    </span>
                    <span>•</span>
                    <span className="flex items-center space-x-1">
                      <Clock className="w-3.5 h-3.5 text-bronze" />
                      <span>{post.readTime}</span>
                    </span>
                  </div>

                  <h3 className="font-serif text-base sm:text-lg font-bold text-charcoal group-hover:text-teal transition-colors leading-snug">
                    {lang === 'es' ? post.titleEs : post.titleEn}
                  </h3>

                  <p className="text-xs text-charcoal-soft leading-relaxed line-clamp-3 font-light">
                    {lang === 'es' ? post.snippetEs : post.snippetEn}
                  </p>
                </div>

                <div className="pt-4 border-t border-linen mt-4">
                  <button
                    onClick={() => setSelectedPost(post)}
                    className="text-xs font-semibold text-teal hover:text-bronze flex items-center space-x-1.5 transition-colors cursor-pointer"
                  >
                    <span>{lang === 'es' ? 'Leer Análisis Completo' : 'Read Full Analysis'}</span>
                    <ArrowRight className="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>

            </div>
          ))}
        </div>

      </div>

      {/* MODAL DE LECTURA DE ARTÍCULO EN MARFIL Y BLANCO */}
      {selectedPost && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-charcoal/70 backdrop-blur-sm animate-in fade-in duration-200">
          <div className="bg-white border border-linen-dark rounded-2xl max-w-2xl w-full p-6 sm:p-8 relative shadow-elevated space-y-5 max-h-[90vh] overflow-y-auto">
            
            <button
              onClick={() => setSelectedPost(null)}
              className="absolute top-5 right-5 text-charcoal-light hover:text-charcoal p-1 rounded-lg transition-colors cursor-pointer"
            >
              <X className="w-5 h-5" />
            </button>

            <span className="text-[10px] text-bronze font-bold uppercase tracking-wider px-2.5 py-0.5 rounded bg-ivory-warm border border-linen-dark">
              {selectedPost.category}
            </span>

            <h3 className="font-serif text-2xl font-bold text-charcoal">
              {lang === 'es' ? selectedPost.titleEs : selectedPost.titleEn}
            </h3>

            <div className="flex items-center space-x-3 text-xs text-charcoal-light">
              <span>{selectedPost.date}</span>
              <span>•</span>
              <span>{lang === 'es' ? 'Redacción Jurídica: Valenzuela & Sterling' : 'By Valenzuela & Sterling Legal Team'}</span>
            </div>

            <div className="h-56 rounded-xl overflow-hidden shadow-subtle bg-linen">
              <img
                src={selectedPost.image}
                alt={selectedPost.titleEs}
                className="w-full h-full object-cover"
              />
            </div>

            <div className="space-y-3 text-xs sm:text-sm text-charcoal-soft leading-relaxed font-light">
              <p>{lang === 'es' ? selectedPost.snippetEs : selectedPost.snippetEn}</p>
              <p>
                {lang === 'es' 
                  ? 'Las leyes migratorias en los Estados Unidos experimentan modificaciones constantes que pueden acelerar o entorpecer los trámites en curso. Recomendamos encarecidamente consultar a un abogado con experiencia antes de presentar formularios ante USCIS o comparecer ante un oficial consular.' 
                  : 'United States immigration policies change frequently, impacting pending applications and eligibility windows. We strongly advise consulting with licensed immigration counsel before filing petitions with USCIS or attending consular interviews.'}
              </p>
            </div>

            <div className="pt-4 border-t border-linen flex flex-col sm:flex-row items-center justify-end gap-3">
              <button
                onClick={() => setSelectedPost(null)}
                className="w-full sm:w-auto px-4 py-2 bg-linen text-charcoal text-xs font-semibold rounded-lg hover:bg-linen-dark cursor-pointer"
              >
                {lang === 'es' ? 'Cerrar' : 'Close'}
              </button>

              <button
                onClick={() => {
                  setSelectedPost(null);
                  onOpenEvaluator();
                }}
                className="w-full sm:w-auto px-6 py-2.5 bg-teal hover:bg-teal-light text-white font-medium text-xs uppercase tracking-wider rounded-lg shadow-sm cursor-pointer"
              >
                {lang === 'es' ? 'Consultar sobre este Tema' : 'Inquire on This Topic'}
              </button>
            </div>

          </div>
        </div>
      )}

    </section>
  );
}
