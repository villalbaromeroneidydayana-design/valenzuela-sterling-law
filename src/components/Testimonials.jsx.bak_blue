import React from 'react';
import { TESTIMONIALS } from '../data/demoData';
import { Star, Quote, CheckCircle, MessageSquare } from 'lucide-react';

export default function Testimonials({ lang }) {
  return (
    <section className="py-20 bg-ivory text-charcoal relative overflow-hidden border-b border-linen-dark/60">
      <div className="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
        
        {/* Cabecera */}
        <div className="text-center max-w-3xl mx-auto space-y-3">
          <div className="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-linen border border-linen-dark text-teal text-xs font-semibold uppercase tracking-wider">
            <MessageSquare className="w-3.5 h-3.5 text-bronze" />
            <span>{lang === 'es' ? 'Voz de Nuestros Clientes' : 'Client Testimonials'}</span>
          </div>

          <h2 className="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-charcoal tracking-tight">
            {lang === 'es' ? (
              <>
                Familias que Hoy Viven con <span className="text-teal italic">Tranquilidad Legal</span>
              </>
            ) : (
              <>
                Families Now Living with <span className="text-teal italic">Lawful Security</span>
              </>
            )}
          </h2>

          <p className="text-charcoal-soft text-sm sm:text-base leading-relaxed font-light">
            {lang === 'es' 
              ? 'Conozca las experiencias de personas, familias y empresarios a quienes hemos acompañado en su proceso migratorio hacia la residencia y la ciudadanía.'
              : 'Read genuine experiences from individuals, families, and entrepreneurs guided through the complex U.S. immigration process.'
            }
          </p>
        </div>

        {/* Grid de 3 Testimonios Destacados en Blanco / Lino */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          {TESTIMONIALS.map((t, idx) => (
            <div
              key={idx}
              className="bg-white border border-linen-dark hover:border-bronze/40 rounded-2xl overflow-hidden shadow-subtle flex flex-col justify-between relative group transition-all duration-300 hover:shadow-premium"
            >
              {/* Fotografía Enmarcada del Testimonio / Caso Aprobado */}
              {t.image && (
                <div className="relative h-56 sm:h-60 overflow-hidden bg-linen border-b border-linen-dark/50">
                  <img
                    src={t.image}
                    alt={`Testimonio de ${t.client}`}
                    loading="lazy"
                    decoding="async"
                    className="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
                  />
                  <div className="absolute inset-0 bg-gradient-to-t from-charcoal/50 via-transparent to-transparent" />
                  
                  {/* Badge de Aprobación Oficial Verificada */}
                  <div className="absolute top-3 left-3 bg-white/95 backdrop-blur-md text-teal font-semibold text-[10px] sm:text-xs px-2.5 py-1 rounded-full border border-linen-dark shadow-sm flex items-center space-x-1.5">
                    <CheckCircle className="w-3.5 h-3.5 text-bronze flex-shrink-0" />
                    <span>{lang === 'es' ? 'Caso Aprobado USCIS' : 'USCIS Approved'}</span>
                  </div>

                  {/* Icono de Cita superpuesto */}
                  <div className="absolute bottom-3 right-3 bg-charcoal/60 backdrop-blur-sm p-1.5 rounded-full text-white/90">
                    <Quote className="w-4 h-4" />
                  </div>
                </div>
              )}

              <div className="p-6 sm:p-7 space-y-4 flex-1 flex flex-col justify-between">
                <div>
                  {/* Estrellas en Bronce */}
                  <div className="flex items-center space-x-1 mb-3">
                    {[...Array(t.stars)].map((_, i) => (
                      <Star key={i} className="w-4 h-4 fill-bronze text-bronze" />
                    ))}
                  </div>

                  <p className="text-xs sm:text-sm text-charcoal-soft italic leading-relaxed font-light">
                    "{lang === 'es' ? t.quoteEs : t.quoteEn}"
                  </p>
                </div>

                <div className="pt-4 border-t border-linen flex items-center justify-between">
                  <div>
                    <h4 className="font-serif text-base font-bold text-charcoal">
                      {t.client}
                    </h4>
                    <div className="text-[11px] text-charcoal-light">
                      {t.city} • <span className="text-teal font-medium">{t.service}</span>
                    </div>
                  </div>

                  <div className="flex items-center space-x-1 text-[10px] text-teal font-semibold bg-linen px-2.5 py-0.5 rounded-full border border-linen-dark">
                    <CheckCircle className="w-3 h-3 text-bronze" />
                    <span>{t.platform}</span>
                  </div>
                </div>
              </div>

            </div>
          ))}
        </div>

      </div>
    </section>
  );
}
